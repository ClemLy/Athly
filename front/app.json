{
  "expo": {
    "name": "Athly",
    "slug": "athly-app",
    "version": "1.0.0",
    "scheme": "athly",
    "orientation": "portrait",
    "icon": "./assets/favicon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1018"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clementin.athly"
    },
    "android": {
      "package": "com.clementin.athly",
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#0D1018"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "icon": "./assets/favicon.png",
      "name": "Athly",
      "shortName": "Athly",
      "description": "Suis tes séances de musculation, gagne de l'XP, débloque des trophées et progresse avec tes amis.",
      "backgroundColor": "#0D1018",
      "themeColor": "#0D1018",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "lang": "fr",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "77fe42fb-95cc-4e79-a150-84228c79e672"
      }
    },
    "owner": "clemly",
    "backgroundColor": "#0D1018",
    "description": "Suis tes séances de musculation, gagne de l'XP, débloque des trophées et progresse avec tes amis."
  }
}
