# ================================
# API
# ================================
# URL du backend Athly.
# - En développement local : ton IP sur le réseau local (pas "localhost" :
#   un téléphone physique ne peut pas le résoudre).
# - Sur Vercel : à définir dans Project Settings > Environment Variables
#   (ex : https://athly-api.onrender.com/api). Sans valeur, le build de
#   production utilise https://athly-api.onrender.com/api par défaut.
#   Si l'API change de domaine, ajoute-le aussi dans connect-src de vercel.json.
API_URL=http://VOTRE_IP_LOCALE:4000/api


# ================================
# JWT & AUTH
# ================================
# Clé utilisée pour stocker le token JWT dans Expo SecureStore
TOKEN_KEY=athly_token


# ================================
# CONFIG APP
# ================================
# development | staging | production
# Les outils de test (God Mode) ne sont disponibles qu'en développement local
# (expo start) ou avec APP_ENV=staging, jamais sur la PWA publique.
APP_ENV=development


# ================================
# CONTACT (pages légales)
# ================================
# Adresse affichée dans la politique de confidentialité pour les demandes
# RGPD. Sans valeur, le dépôt GitHub du projet sert de point de contact.
SUPPORT_EMAIL=


# ================================
# GOOGLE OAUTH (Section VIII)
# ================================
# Client IDs OAuth 2.0 créés dans Google Cloud Console (console.cloud.google.com
# > APIs & Services > Identifiants). Un ID par plateforme car chacun a un
# type d'application différent :
#  - GOOGLE_EXPO_CLIENT_ID   : type "Web", utilisé pour le proxy Expo Go en dev
#  - GOOGLE_IOS_CLIENT_ID    : type "iOS", bundle ID com.clementin.athly
#  - GOOGLE_ANDROID_CLIENT_ID: type "Android", package com.clementin.athly
#  - GOOGLE_WEB_CLIENT_ID    : type "Web", utilisé pour la version PWA/web
# Tant qu'ils ne sont pas renseignés, le bouton Google reste désactivé côté
# front (voir useGoogleAuth.js) ; le backend répond 501 de toute façon sans
# GOOGLE_CLIENT_ID configuré côté serveur (voir back/.env).
GOOGLE_EXPO_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
