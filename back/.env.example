# ------------------------------
# Configuration serveur
# ------------------------------
PORT=4000


# ------------------------------
# Base de données MongoDB
# ------------------------------
# Connection string MongoDB Atlas ou local
# Exemple Atlas : mongodb+srv://username:password@cluster.mongodb.net/athly
# Exemple local : mongodb://localhost:27017/athly
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/athly


# ------------------------------
# JWT (authentification)
# ------------------------------
# Clé secrète longue et aléatoire (32 caractères minimum en production,
# sinon le serveur refuse de démarrer). Générer avec :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=VOTRE_JWT_SECRET_TRES_LONG_ET_ALEATOIRE


# ------------------------------
# Durée de validité des tokens
# ------------------------------
# Exemples : 1h, 2d, 7d, 30m
JWT_EXPIRES_IN=1d


# ------------------------------
# Email / SMTP  (Brevo)
# ------------------------------
# Utilisé pour envoyer les codes OTP (vérification email, reset password)
SMTP_HOST=smtp-relay.brevo.com
# Port 587 en dev (STARTTLS), port 2525 si 587 est bloqué sur le réseau
SMTP_PORT=587
# Credential d'authentification Brevo (onglet SMTP & API de ton compte)
SMTP_USER=votre_login@smtp-brevo.com
# Clé SMTP générée dans Brevo (SMTP & API > Generate a new SMTP key)
SMTP_PASS=VOTRE_CLE_SMTP_BREVO
# Adresse d'expédition — doit être un expéditeur vérifié dans Brevo
# (Brevo dashboard > Senders & IPs > Add a sender)
# Différent de SMTP_USER : c'est l'adresse visible par le destinataire
SMTP_FROM=votre.adresse.verifiee@domaine.com


# ------------------------------
# Environnement
# ------------------------------
# development | production
# OBLIGATOIRE : NODE_ENV=production sur Render. Il masque les détails
# techniques des erreurs et ferme les routes de test God Mode (/api/debug).
NODE_ENV=development

# Routes de test God Mode sur un serveur hébergé (recette uniquement).
# Sur Render, elles restent fermées tant que cette variable n'est pas à true.
ENABLE_DEBUG_ROUTES=false


# ------------------------------
# Google OAuth (Section VIII)
# ------------------------------
# Liste des Client IDs OAuth 2.0 créés dans Google Cloud Console, séparés par
# des virgules (un par plateforme front : iOS, Android, Web, Expo Go ; voir
# front/.env.example). Vide : POST /api/auth/google répond 501.
# Exemple : GOOGLE_CLIENT_IDS=xxxx-ios.apps.googleusercontent.com,xxxx-android.apps.googleusercontent.com,xxxx-web.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=


# ------------------------------
# CORS (production)
# ------------------------------
# Allowlist des origines web autorisées, séparées par des virgules.
# Les requêtes sans header Origin (app mobile native) ne sont pas concernées.
# Non définie : CORS permissif (dev uniquement, avertissement logué en production).
# En production, mettre le domaine Vercel de la PWA.
# Exemple : CORS_ORIGINS=https://athly.vercel.app,https://www.athly.app
CORS_ORIGINS=
